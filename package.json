{
  "name": "loupe",
  "version": "1.0.0",
  "private": true,
  "description": "Loupe: a mobile-first trainer for evaluating Magic: The Gathering Limited cards against 17Lands data.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "data": "tsx pipeline/cli.ts build",
    "data:offline": "tsx pipeline/cli.ts build --offline",
    "status": "tsx pipeline/cli.ts status",
    "synth": "tsx pipeline/cli.ts synth",
    "corpus:record": "tsx pipeline/cli.ts corpus-record",
    "corpus:drift": "tsx pipeline/cli.ts corpus-drift",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:budgets": "playwright test --project=budgets",
    "lighthouse": "tsx scripts/lighthouse.ts"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "dexie": "^4.4.6",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chrome-launcher": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "lighthouse": "^13.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1"
  }
}
